        "design": "Cross-sectional study",
        "case_sources": [],
        "reference_sources": ["prams_p7_arf", "prams_p8_arf"],
        "denominator_sources": ["cdc_linkco15"],
        "period_start": 2016,
        "period_end": 2019,
        "variables": ["prams_p8_std2:SOCIOECONOMIC_STATUS"]
    },

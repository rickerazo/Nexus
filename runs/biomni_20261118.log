def add_question(statement, design, rationale, prior_art, case_sources, reference_sources, denominator_sources, period_start, period_end, variables, cannot_establish):
    question = {
        "rank": len(questions) + 1,
        "statement": statement,
        "design": design,
        "rationale": rationale,
        "prior_art": prior_art,
        "case_sources": case_sources,
        "reference_sources": reference_sources,
        "denominator_sources": denominator_sources,
        "period_start": period_start,
        "period_end": period_end,
        "variables": variables,
        "cannot_establish": cannot_establish
    }
    questions.append(question)

# Example question based on identified variable BFACIL
add_question(
    statement="Does geographic variation in birthplace affect the incidence of SUID?",

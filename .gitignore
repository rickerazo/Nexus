# This project is open source: inputs (documentation only, no row-level data) and every run artifact are
# tracked. Ignored are secrets, caches, and files we may not or cannot redistribute.

# secrets
.env
.env.*
!.env.example

# python and tool caches
__pycache__/
*.pyc
.venv/
dist/
build/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
# hash-keyed extracted text and embeddings (about 100 MB, rebuilt on demand)
.cache/

# os and editor
.DS_Store
.vscode/

# Biomni benchmark sandbox HOME (matplotlib cache only)
runs/*/home/

# legacy prototype: a 102 MB deck (over GitHub's 100 MB file limit) and third-party journal articles
# (copyright of their publishers; cited in the legacy notes, not redistributed)
legacy/ai_for_science/Soria Moria 2024 closer to final.pptx
legacy/ai_for_science/bibliography_respirationSD/*.pdf
legacy/ai_for_science/bibliography_respirationSD2/*.pdf
legacy/ai_for_science/molecular_refs_01/*.pdf
legacy/ai_for_science/epidemiology_NB/*.pdf

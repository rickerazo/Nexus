# MMF reads credentials ONLY from explicit MMF_* environment variables. No key file is loaded.
# The default backend (Ollama) needs nothing. A cloud backend additionally needs
# `allow_cloud: true` in the run config and an INSTITUTIONAL credential - never a personal key.
# export MMF_OLLAMA_HOST=http://localhost:11434
# export MMF_API_KEY=...            # institutional OpenAI-compatible credential
# export MMF_API_BASE_URL=https://...  # institutional gateway / Azure endpoint (optional)
